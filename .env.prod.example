# ProStock Production Environment Variables
# Copy this file to .env.prod and fill in real values before running:
#   docker compose -f docker-compose.prod.yml up -d --build

# Your domain name (used by Caddy for automatic TLS)
DOMAIN=prostock.example.com

# PostgreSQL credentials — use strong random values in production
POSTGRES_USER=prostock
POSTGRES_PASSWORD=change-me-to-a-strong-password

# Session secret — must be at least 32 characters (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-at-least-32-chars-long-random-string

# Database URL (constructed from POSTGRES_USER/PASSWORD above)
# Format: postgresql://USER:PASSWORD@db:5432/DBNAME
DATABASE_URL=postgresql://prostock:change-me-to-a-strong-password@db:5432/prostock
